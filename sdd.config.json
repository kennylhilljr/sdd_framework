{
  "$schema": "./tools/sdd/sdd.config.schema.json",
  "frameworkVersion": "1.1.1",
  "project": {
    "name": "sdd_framework",
    "description": "Spec-driven development toolkit with a synthetic Tech domain reference example",
    "scope": "example-application"
  },
  "paths": {
    "docs": "docs",
    "codeRoots": [
      "src"
    ],
    "testRoots": [
      "test"
    ],
    "traceIndex": "docs/trace/index.yaml",
    "coverage": "docs/trace/coverage.md",
    "docMap": "docs/README.md",
    "scopeMap": "docs/scope/scope-map.yaml"
  },
  "ids": {
    "criterionPattern": null
  },
  "approvals": {
    "requireApprover": false
  },
  "components": {
    "tech": {
      "prefix": "TECH",
      "paths": [
        "src/tech",
        "test/tech"
      ],
      "scope": "example-application"
    },
    "billing": {
      "prefix": "BILL",
      "paths": [
        "src/billing",
        "test/billing"
      ],
      "scope": "example-application"
    }
  },
  "trace": {
    "staleAfterDays": 30,
    "reachWarnBelow": 0.8
  },
  "features": {
    "gateHook": true,
    "protectApprovedDocs": true,
    "reachReport": true,
    "divergenceProbe": false,
    "differentialAudit": false,
    "autoAcceptClaudeRecommendations": false
  }
}
